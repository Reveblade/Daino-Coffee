NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/daino
JWT_SECRET=change-me-min-16-chars-long
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:5173
MENU_PUBLIC_BASE_URL=https://your-menu-host.example.com

# Owner (ADMIN_OWNER) — seeded on startup; uses password login (no SMS)
OWNER_PHONE_E164=+905551112233
OWNER_PASSWORD=your-strong-password

# Netgsm SMS (https://api.netgsm.com.tr/sms/send/xml). If unset or NETGSM_OTP_DISABLED=true, OTP is logged instead of sent.
NETGSM_USERCODE=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
NETGSM_OTP_DISABLED=true

# Cloudinary (optional; QR/menu uploads skip if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
