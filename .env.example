NODE_ENV=development
# Cloud Run injects PORT (default 8080). Local dev often uses 3000.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/daino
JWT_SECRET=change-me-min-16-chars-long
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-refresh-secret-16
JWT_REFRESH_EXPIRES_IN=7d
# Vite default :5173 — use both if you open the app via localhost or 127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# Same origin as the customer site (QR opens this URL). Dev: Vite :5173; prod: your Cloud Run / CDN URL for the **customer** frontend (scheme + host, no trailing slash).
MENU_PUBLIC_BASE_URL=http://localhost:5173

# --- Google Cloud Run (summary) ---
# - Set secrets via Secret Manager or `--set-secrets`; never bake .env into images.
# - Use MONGODB_URI for Atlas or a private VPC MongoDB (not localhost).
# - CORS_ORIGINS: comma-separated list of deployed frontend origins (customer + authority), or * only if you accept the tradeoff.
# - Request timeout: raise if you rely on long-lived HTTP (WebSockets use a separate upgrade path; configure idle timeout on the service if needed).

# Owner (ADMIN_OWNER) — password login; phone accepts 555…, 0555…, +90555… (normalized to +90…)
OWNER_PHONE_E164=+905551112233
OWNER_PASSWORD=your-strong-password

# Netgsm OTP SMS (REST v2). API user + approved msgheader; OTP paketi gerekir.
# https://www.netgsm.com.tr/dokuman — If creds incomplete or NETGSM_OTP_DISABLED=true, OTP is logged instead of sent.
NETGSM_USERNAME=
NETGSM_PASSWORD=
NETGSM_MSGHEADER=
# Optional: SDK / Netgsm appname (see Netgsm panel)
NETGSM_APPNAME=
NETGSM_OTP_DISABLED=true

# Cloudinary (optional; QR/menu uploads skip if empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
