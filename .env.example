# Public API (no trailing slash); includes /v1
VITE_API_BASE_URL=http://localhost:3000/v1

# Optional: override native WebSocket URL for store push (default: same host as API, path /ws/store)
# VITE_WS_URL=ws://localhost:3000/ws/store

# Optional: enables Google Maps address picking in customer address forms.
# Restrict this browser key to your frontend domains in Google Cloud Console.
# VITE_GOOGLE_MAPS_API_KEY=

# --- Docker / Cloud Run ---
# Pass at image build time, e.g.:
#   docker build --build-arg VITE_API_BASE_URL=https://api.example.com/v1 --build-arg VITE_WS_URL=wss://api.example.com/ws/store --build-arg VITE_GOOGLE_MAPS_API_KEY=... -t daino-frontend .
# Cloud Build: use substitutions for the same ARG names.
